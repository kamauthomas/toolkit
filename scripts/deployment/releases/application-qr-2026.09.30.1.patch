+/** QR-link openings use the same daily aggregate storage as other interactions. */
+function toolkit_application_qr_scans( $days = 30 ) {
+	global $wpdb;
+	toolkit_metrics_install_storage();
+	$table = toolkit_metrics_table_name();
+	$since = $days ? gmdate( 'Y-m-d', strtotime( '-' . max( 0, $days - 1 ) . ' days' ) ) : '1970-01-01';
+	return (int) $wpdb->get_var( $wpdb->prepare(
+		"SELECT COALESCE(SUM(metric_count),0) FROM {$table} WHERE path=%s AND event=%s AND metric_date >= %s",
+		'/apply/', 'interaction:application_qr_scan', $since
+	) );
+}
